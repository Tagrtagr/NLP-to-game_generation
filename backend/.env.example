ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TRIPO_API_KEY=
PIXELLAB_API_KEY=

# Optional: if set, design/synthesize/critic/vision QA use OpenRouter instead
# of direct Anthropic/Gemini keys.
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_CRITIC_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Godot Agent

# Asset generation is retried once by default before a fallback is considered.
ASSET_GENERATION_RETRIES=1
ASSET_TIMEOUT_SPRITE=90
ASSET_TIMEOUT_TILESET=90
ASSET_TIMEOUT_BG=120
ASSET_TIMEOUT_UI=120
ASSET_TIMEOUT_MESH=240
PIXELLAB_CONCURRENCY=1
GPT_IMAGE_CONCURRENCY=2
TRIPO_CONCURRENCY=1

# Leave false for public deployments. If true, missing generated assets can ship
# procedural placeholder blocks when bundled fallback art is unavailable.
ALLOW_PLACEHOLDER_FALLBACKS=false

# Comma-separated frontend origins allowed to call this backend.
# Local default if unset: http://localhost:5173,http://127.0.0.1:5173
# Hosted example: https://your-vercel-project.vercel.app
CORS_ALLOW_ORIGINS=

# Optional durable saved-games storage. If unset, saves use backend/saved_games/
# and generated game files remain in backend/workspaces/.
DATABASE_URL=
SAVE_DATABASE_URL=
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
# Optional CDN/custom-domain base URL, for example:
# https://your-space.nyc3.cdn.digitaloceanspaces.com
SPACES_PUBLIC_BASE_URL=

# Public URL that Playwright QA should use to load generated web builds.
# Local default is http://127.0.0.1:8000.
# Hosted example: https://your-backend.example.com
QA_BASE_URL=

# Optional override for Godot. Docker sets this automatically.
GODOT_BIN=
