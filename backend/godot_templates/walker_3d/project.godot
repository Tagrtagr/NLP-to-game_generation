; Engine configuration file.
; Minimal-viable walker_3d template. Capsule-primitive player stands in for
; Tripo / Kenney humanoid; synthesize swaps MeshInstance3D.mesh to a real mesh.

config_version=5

[application]

config/name="Walker 3D Template"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ReadySignal="*res://autoload/ready_signal.gd"
ScreenShake="*res://autoload/screen_shake.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"

