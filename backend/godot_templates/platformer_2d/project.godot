; Engine configuration file.
; Minimal-viable platformer_2d template. Synthesize phase customizes
; scripts, scenes, shaders, and swaps ColorRect visuals for sprites.

config_version=5

[application]

config/name="Platformer 2D Template"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://icon.svg"

[autoload]

ReadySignal="*res://autoload/ready_signal.gd"
ScreenShake="*res://autoload/screen_shake.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[input]

